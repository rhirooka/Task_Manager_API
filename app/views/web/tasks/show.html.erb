<%= link_to "← 一覧に戻る",
            dashboard_path,
            class: "button" %>

<h1><%= @task.title %></h1>

<div class="card">
  <h2>タスクの詳細</h2>

  <p>
    <strong>ID：</strong>
    <%= @task.id %>
  </p>

  <p>
    <strong>説明：</strong>
    <%= @task.description.presence || "説明なし" %>
  </p>

  <p>
    <strong>進捗：</strong>

    <% if @task.completed? %>
      完了
    <% else %>
      未完了
    <% end %>
  </p>

  <p>
    <strong>作成日時：</strong>
    <%= @task.created_at.strftime("%Y/%m/%d %H:%M") %>
  </p>




  # 詳細画面に編集・更新・削除ボタンを追加
    <h2>タスク操作</h2>

  <p>
    <%= link_to "編集する",
                edit_dashboard_task_path(@task),
                class: "button" %>
  </p>

  <p>
    <%= button_to(
          @task.completed? ? "未完了に戻す" : "完了にする",
          dashboard_task_path(@task),
          method: :patch,
          params: {
            task: { completed: !@task.completed? }
          }
        ) %>
  </p>

  <p>
    <%= button_to "削除する",
                  dashboard_task_path(@task),
                  method: :delete %>
  </p>



</div>